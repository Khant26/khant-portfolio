# Generated by Sawyun project IDE: serves the static site with nginx.
FROM nginx:1.27-alpine
COPY . /usr/share/nginx/html/
RUN cd /usr/share/nginx/html && rm -rf .git .github .gitattributes .gitignore README.md design-qa.md myCV/README.md
# Clean URLs like Vercel: /page serves page.html. Images are cached for a week.
RUN printf 'server {\n  listen 80;\n  root /usr/share/nginx/html;\n  gzip on;\n  gzip_types text/css application/javascript application/json image/svg+xml;\n  location /assets/ { add_header Cache-Control "public, max-age=604800"; }\n  location / { try_files $uri $uri.html $uri/ =404; }\n}\n' > /etc/nginx/conf.d/default.conf
